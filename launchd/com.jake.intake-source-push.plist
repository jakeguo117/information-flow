<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 2026-11-01 起停用，留作备份，不要再装。现在由另一台常开的 Mac 唯一推送 Snipd、WeRead、Books，见 docs/digitalbrain-sync.md。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jake.intake-source-push</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/osascript</string>
    <string>/Users/jake/plugins/information-flow/scripts/run_intake_source_push.applescript</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>14400</integer>
  <key>WorkingDirectory</key>
  <string>/Users/jake/plugins/information-flow</string>
  <key>StandardOutPath</key>
  <string>/Users/jake/plugins/information-flow/state/intake-source-push.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jake/plugins/information-flow/state/intake-source-push.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/jake</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
